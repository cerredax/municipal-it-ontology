    <!-- https://w3id.org/municipal-it-incidents#affectsDevice -->


    <owl:ObjectProperty rdf:about="https://w3id.org/municipal-it-incidents#affectsDevice">
        <rdfs:domain rdf:resource="https://w3id.org/municipal-it-incidents#ITIncident"/>
        <rdfs:range rdf:resource="https://w3id.org/municipal-it-incidents#Device"/>
        <rdfs:comment xml:lang="en">A device affected by an incident; an incident may affect several devices.</rdfs:comment>
        <rdfs:label xml:lang="en">affectsDevice</rdfs:label>
    </owl:ObjectProperty>
    


