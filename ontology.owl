<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/municipal-it-incidents#"
     xml:base="https://w3id.org/municipal-it-incidents"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="https://w3id.org/widoco/vocab#"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/municipal-it-incidents">
        <owl:versionIRI rdf:resource="https://w3id.org/municipal-it-incidents/1.1"/>
        <terms:abstract xml:lang="en">An OWL 2 ontology for describing municipal IT incidents, employees, departments, devices and technician assignments.</terms:abstract>
        <terms:creator>Omar García Carballo</terms:creator>
        <terms:description xml:lang="en">The ontology supports a small municipal helpdesk. It models incident reporting, affected devices, current status and priority, assignment to technicians and employee department membership. Software applications, network infrastructure, service-level agreements and change management are outside its scope.</terms:description>
        <terms:language>en</terms:language>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-05</terms:modified>
        <terms:title xml:lang="en">Municipal IT Incident Ontology</terms:title>
        <vann:preferredNamespacePrefix>mit</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/municipal-it-incidents#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Course project. OWL describes the domain under the open-world assumption. Required-field, unique identifier and missing-assignment checks require closed-world application or SHACL validation.</rdfs:comment>
        <rdfs:label xml:lang="en">Municipal IT Incident Ontology</rdfs:label>
        <owl:versionInfo>1.1</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/cerredax/municipal-it-ontology"/>
        <vocab:description xml:lang="en">Technician specialises Employee; Computer and Printer specialise Device. Each incident has one reporter, identifier, description, reporting date, status and priority, and at most one assigned technician. In-progress and resolved incidents require an assignment. Open-world OWL semantics do not validate missing fields or unique identifiers in application records; those checks require application logic or SHACL. Only current status is represented, not status history.</vocab:description>
        <vocab:introduction xml:lang="en">This vocabulary was developed by Omar García Carballo as a practical ontology engineering course project. Intended users are municipal helpdesk staff and developers of interoperable incident management systems.</vocab:introduction>
    </owl:Ontology>
    


