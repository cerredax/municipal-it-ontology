@prefix : <https://w3id.org/municipal-it-incidents#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/municipal-it-incidents#> .

<https://w3id.org/municipal-it-incidents> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/municipal-it-incidents/1.1> ;
                                           <http://purl.org/dc/terms/abstract> "An OWL 2 ontology for describing municipal IT incidents, employees, departments, devices and technician assignments."@en ;
                                           <http://purl.org/dc/terms/creator> "Omar García Carballo" ;
                                           <http://purl.org/dc/terms/description> "The ontology supports a small municipal helpdesk. It models incident reporting, affected devices, current status and priority, assignment to technicians and employee department membership. Software applications, network infrastructure, service-level agreements and change management are outside its scope."@en ;
                                           <http://purl.org/dc/terms/language> "en" ;
                                           <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                           <http://purl.org/dc/terms/modified> "2026-11-05"^^xsd:date ;
                                           <http://purl.org/dc/terms/title> "Municipal IT Incident Ontology"@en ;
                                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "mit" ;
                                           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/municipal-it-incidents#" ;
                                           rdfs:comment "Course project. OWL describes the domain under the open-world assumption. Required-field, unique identifier and missing-assignment checks require closed-world application or SHACL validation."@en ;
                                           rdfs:label "Municipal IT Incident Ontology"@en ;
                                           owl:versionInfo "1.1" ;
                                           <https://schema.org/codeRepository> <https://github.com/cerredax/municipal-it-ontology> ;
                                           <https://w3id.org/widoco/vocab#description> "Technician specialises Employee; Computer and Printer specialise Device. Each incident has one reporter, identifier, description, reporting date, status and priority, and at most one assigned technician. In-progress and resolved incidents require an assignment. Open-world OWL semantics do not validate missing fields or unique identifiers in application records; those checks require application logic or SHACL. Only current status is represented, not status history."@en ;
                                           <https://w3id.org/widoco/vocab#introduction> "This vocabulary was developed by Omar García Carballo as a practical ontology engineering course project. Intended users are municipal helpdesk staff and developers of interoperable incident management systems."@en .

